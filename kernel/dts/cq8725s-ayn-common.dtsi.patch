From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: cq8725s: configure the Odin 3 gamepad and DP audio

--- a/arch/arm64/boot/dts/qcom/cq8725s-ayn-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/cq8725s-ayn-common.dtsi
@@ -113,7 +113,6 @@
 			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
 			debounce-interval = <15>;
 			linux,can-disable;
-			wakeup-source;
 		};
 	};
 
@@ -182,5 +182,21 @@
 			platform {
 				sound-dai = <&q6apm>;
 			};
 		};
+
+		dp-dai-link {
+			link-name = "DisplayPort Playback";
+
+			codec {
+				sound-dai = <&mdss_dp0>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
 	};
@@ -1390,6 +1390,9 @@
 
 	gamepad {
 		compatible = "gamepad,rsinput";
+		rumble-haptics;
+		axis-range = <1024>;
+		axis-deadzone = <70>;
 
 		gamepad-name = "AYN Odin3 Gamepad";
 		gamepad-bus = <0x0003>;
